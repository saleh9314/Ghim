# Every file in assets/optimized has a content hash in its filename.
/assets/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/404.html
  X-Robots-Tag: noindex

# These repository support files are public, but are not search landing pages.
/docs/*
  X-Robots-Tag: noindex
/scripts/*
  X-Robots-Tag: noindex
/tests/*
  X-Robots-Tag: noindex
/README.md
  X-Robots-Tag: noindex
/assets/image-manifest.json
  X-Robots-Tag: noindex

/assets/fonts-manifest.json
  X-Robots-Tag: noindex
